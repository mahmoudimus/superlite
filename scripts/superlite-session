#!/usr/bin/env python3
"""Start a separate Superlite session using the host's workflow controls."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
CODEX_PLUGIN = "superlite@superlite-maintained"


def workflow_plugin(plugin_id):
    return plugin_id.split("@", 1)[0] in {"superlite", "superpowers"}


def claude_plugins():
    result = subprocess.run(
        ["claude", "plugin", "list", "--json"], check=True, capture_output=True, text=True,
    )
    return json.loads(result.stdout)


def claude_command(args):
    disable = {
        plugin["id"]: False
        for plugin in claude_plugins()
        if workflow_plugin(plugin["id"])
    }
    return ["claude", "--settings", json.dumps({"enabledPlugins": disable}), "--plugin-dir", str(ROOT), *args]


def codex_home():
    return Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()


def read_plugins(path):
    try:
        with path.open("rb") as f:
            return tomllib.load(f).get("plugins", {})
    except FileNotFoundError:
        return {}


def project_plugins():
    cwd = Path.cwd()
    dirs = [cwd, *cwd.parents]
    root = next((i for i, path in enumerate(dirs) if (path / ".git").exists()), 0)
    plugins = {}
    for folder in reversed(dirs[:root + 1]):
        for key, value in read_plugins(folder / ".codex/config.toml").items():
            if "enabled" in value:
                plugins[key] = value["enabled"]
    return plugins


def codex_settings():
    home = codex_home()
    keys = (read_plugins(home / "config.toml").keys()
            | read_plugins(home / "superlite.config.toml").keys()
            | project_plugins().keys())
    plugins = {key: False for key in keys if workflow_plugin(key)}
    plugins[CODEX_PLUGIN] = True
    return plugins


def codex_command(args):
    flags = args[:args.index("--")] if "--" in args else args
    if any(flag == "--cd" or flag.startswith(("-C", "--cd=")) for flag in flags):
        raise ValueError("start the launcher from the target directory instead of using Codex --cd")
    expected = codex_settings()
    for key, enabled in project_plugins().items():
        if key in expected and enabled != expected[key]:
            raise ValueError(f"workspace configuration conflicts with Superlite: {key}. "
                             "Use a dedicated checkout or update its .codex/config.toml.")
    profile = codex_home() / "superlite.config.toml"
    current = read_plugins(profile)
    if any(current.get(key, {}).get("enabled") != value for key, value in expected.items()):
        raise ValueError(f"save the output of 'superlite-session codex-config' into {profile} "
                         "before starting a Codex Superlite session")
    return ["codex", "--profile", "superlite", *args]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("host", choices=("claude", "pi", "codex", "codex-config"))
    parser.add_argument("args", nargs=argparse.REMAINDER, metavar="host-arg")
    args = parser.parse_args()
    try:
        if args.host == "codex-config":
            if args.args:
                parser.error("codex-config takes no arguments")
            print("# Superlite workflow selection", end="\n")
            for key, enabled in sorted(codex_settings().items()):
                print(f"\n[plugins.{json.dumps(key, ensure_ascii=False)}]\nenabled = {str(enabled).lower()}")
            return 0
        if args.host == "claude":
            command = claude_command(args.args)
        elif args.host == "pi":
            command = ["pi", "--no-extensions", "--no-skills", "--no-approve", "-e", str(ROOT), *args.args]
        else:
            command = codex_command(args.args)
        os.execvp(command[0], command)
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        parser.exit(1, f"superlite-session: {exc}\n")


if __name__ == "__main__":
    sys.exit(main())
